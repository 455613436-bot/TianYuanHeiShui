[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/Main.gd" id="1_main"]
[ext_resource type="Texture2D" path="res://assets/scenes/village_chief_house.png" id="2_background"]
[ext_resource type="Script" path="res://scripts/entities/NpcInteractable.gd" id="3_npc"]
[ext_resource type="Script" path="res://scripts/ui/DialogueUI.gd" id="4_dialogue"]

; ─── 村长家场景：固定背景，进入即对话 ──────────────────────────────
; 玩家从世界地图选择"村口广场"后会进入本场景，看到村长家室内背景，
; DialogueUI 会自动打开，无需移动或按键触发。

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

; ─── 场景背景：村长家室内（CanvasLayer + Control 保证铺满屏幕） ──
[node name="BackgroundLayer" type="CanvasLayer" parent="."]
layer = -1

[node name="Background" type="TextureRect" parent="BackgroundLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_right = 0.0
offset_bottom = 0.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5
texture = ExtResource("2_background")

[node name="TopShade" type="ColorRect" parent="BackgroundLayer"]
anchor_right = 1.0
offset_bottom = 84.0
mouse_filter = 2
color = Color(0.02, 0.025, 0.02, 0.72)

[node name="LocationTitle" type="Label" parent="BackgroundLayer/TopShade"]
anchor_right = 1.0
offset_top = 14.0
offset_bottom = 50.0
text = "村口广场 · 村长家"
horizontal_alignment = 1
theme_override_colors/font_color = Color(1, 0.91, 0.65, 1)
theme_override_font_sizes/font_size = 26

[node name="LocationSubtitle" type="Label" parent="BackgroundLayer/TopShade"]
anchor_right = 1.0
offset_top = 50.0
offset_bottom = 80.0
text = "进入场景自动开启与村长的对话"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.88, 0.88, 0.8, 1)
theme_override_font_sizes/font_size = 16

; ─── 村长 NPC（不可移动，仅用于绑定 profile + 自动开对话） ───────
[node name="NpcWuZhiyuan" type="Node2D" parent="."]
script = ExtResource("3_npc")
npc_id = "wu_zhiyuan"
npc_md_path = "res://data/npcs/wu_zhiyuan.md"
npc_json_path = "res://data/npcs/wu_zhiyuan.json"

; ─── HUD：右上角返回世界地图按钮 ──────────────────────────────────
[node name="HUD" type="CanvasLayer" parent="."]

[node name="ReturnMapButton" type="Button" parent="HUD"]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -214.0
offset_top = 20.0
offset_right = -24.0
offset_bottom = 68.0
grow_horizontal = 0
text = "打开地图  M / Esc"
theme_override_font_sizes/font_size = 18

; ─── Dialogue UI：进入场景即打开 ──────────────────────────────────
[node name="DialogueUI" type="CanvasLayer" parent="."]
script = ExtResource("4_dialogue")
layer = 10

[node name="RootPanel" type="Panel" parent="DialogueUI"]
anchor_left = 0.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 0.0
offset_top = -260.0
offset_right = 0.0
offset_bottom = 0.0
grow_horizontal = 2
grow_vertical = 0

[node name="HBox" type="HBoxContainer" parent="DialogueUI/RootPanel"]
anchors_preset = 15

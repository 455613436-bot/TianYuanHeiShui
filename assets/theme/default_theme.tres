[gd_resource type="Theme" load_steps=2 format=3]

; 项目默认主题：把思源宋体 Bold 作为所有 Control 的默认字体。
; 单个节点若仍设置 theme_override_fonts/xxx，则以节点覆盖为准。
[ext_resource type="Font" path="res://assets/fonts/game_font.tres" id="1_default_font"]

[resource]
default_font = ExtResource("1_default_font")
default_font_size = 16
